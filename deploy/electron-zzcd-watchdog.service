[Unit]
Description=Electron ZZCD Watchdog
After=graphical.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=firefly
Group=firefly
WorkingDirectory=/opt/electron-demo
ExecStart=/opt/electron-demo/electron-pure-kehua-zero
Restart=always
RestartSec=3

# 这里的值需要和 index.js 里的 RUNTIME_LIMITS 保持一致。
MemoryHigh=470M
MemoryMax=500M
OOMPolicy=stop

# X11 桌面环境变量，需要按板子上的实际用户和会话调整。
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/firefly/.Xauthority
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
Environment=NODE_ENV=production

# Electron 主窗口已在 index.js 中固定加载 http://127.0.0.1:18088/index.html，
# 因此 nginx 和 /opt/zd-test-client/www 必须先部署好。

[Install]
WantedBy=graphical.target
